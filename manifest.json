{
  "manifest_version": 3,
  "name": "Instant Dictionary",
  "version": "1.1.0",
  "description": "Double-click or right-click any word to instantly see its definition and hear its pronunciation.",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://api.datamuse.com/*",
    "https://en.wiktionary.org/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/render.js", "src/content.js"],
      "css": ["src/card.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
